NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/arovix
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=replace-with-a-long-development-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-development-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECRET=replace-with-a-long-cookie-secret
LOG_LEVEL=info
EMAILJS_SERVICE_ID=
# EmailJS public key, sent as REST API user_id.
EMAILJS_API_KEY=
# EmailJS private key/access token. Keep this server-side only.
EMAILJS_PRIVATE_KEY=
EMAILJS_CONTACT_TEMPLATE_ID=
EMAILJS_CAREER_TEMPLATE_ID=
# Optional user confirmation templates.
EMAILJS_CONTACT_CONFIRMATION_TEMPLATE_ID=
EMAILJS_CAREER_CONFIRMATION_TEMPLATE_ID=
ADMIN_NOTIFICATION_EMAIL=
