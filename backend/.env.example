NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/brainybeam
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=replace-with-a-long-development-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-development-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECRET=replace-with-a-long-cookie-secret
LOG_LEVEL=info
# SMTP settings. For Gmail use an App Password (https://myaccount.google.com/apppasswords).
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASSWORD=
# Where admin notifications (new inquiries/applications) are delivered.
ADMIN_NOTIFICATION_EMAIL=
