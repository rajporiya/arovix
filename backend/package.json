    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.3",
    "nodemailer": "^10.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
